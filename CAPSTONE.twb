      <aliases enabled='yes' />
      <column caption='Arrival Date' datatype='date' name='[Arrival_Date]' role='dimension' type='ordinal' />
      <column caption='Boarding Minutes' datatype='real' name='[Boarding_Minutes]' role='measure' type='quantitative' />
      <column caption='total encounters' datatype='integer' name='[Calculation_147211477331234816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Is_Valid_Encounter] = 1 THEN [encounter_id] END)' />
      </column>
      <column caption='Admissions' datatype='integer' name='[Calculation_147211477331374081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Is_Valid_Encounter] = 1 AND NOT ISNULL([admission_ts]) THEN [encounter_id] END)' />
      </column>
      <column caption='Discharges' datatype='integer' name='[Calculation_147211477331443714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Is_Valid_Encounter] = 1 AND NOT ISNULL([discharge_ts]) THEN [encounter_id] END)' />
      </column>
      <column caption='Avg ED wait time ( mins )' datatype='real' name='[Calculation_147211477331537923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Is_Valid_Encounter] = 1 THEN [ED_Wait_Minutes] END)' />
      </column>
      <column caption='Avg Boarding Time(mins)' datatype='real' name='[Calculation_147211477331750916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Is_Valid_Encounter] = 1 THEN [Boarding_Minutes] END)' />
      </column>
      <column caption='Avg LOS' datatype='real' name='[Calculation_147211477331820549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Is_Valid_Encounter] = 1 THEN [LOS_Hours] END) / 24.0' />
      </column>
      <column caption='Avg LOS days' datatype='real' name='[Calculation_147211477331902470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Is_Valid_Encounter] = 1 THEN [LOS_Hours] END) / 24.0' />
      </column>
      <column caption='Excluded Encounters (DQ Audit)' datatype='integer' name='[Calculation_147211477331984391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Is_Valid_Encounter] = 0 THEN [encounter_id] END)' />
      </column>
      <column caption='Total Raw Encounters' datatype='integer' name='[Calculation_147211477332033544]' role='measure' type='quantitative'>
